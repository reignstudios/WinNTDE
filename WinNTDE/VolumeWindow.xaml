<Window x:Class="WinNTDE.VolumeWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume" Style="{DynamicResource ShellWindow}" Width="246" Height="64"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="VolumeLabel" Text="Volume" FontWeight="SemiBold"/>
            <TextBlock x:Name="VolumeValue" HorizontalAlignment="Right"/>
            <ProgressBar x:Name="LevelBar" Grid.Row="1" Height="6" VerticalAlignment="Center"
                         AutomationProperties.Name="Output volume" Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource Line}">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
