<Window x:Class="WinNTDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNTDE Desktop" WindowStyle="None" ShowActivated="False" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="Black" Foreground="White" FontSize="13" FontFamily="Segoe UI, Tahoma">
    <Grid>
        <Image x:Name="Wallpaper" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <ListBox x:Name="Icons" Margin="10,10,10,50" Background="Transparent" Foreground="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Vertical"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="93" Height="77" Margin="3" ToolTip="{Binding Path}">
                        <Image Source="{Binding Icon}" Width="35" Height="35" Margin="0,6,0,5"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="3"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
