<Window x:Class="WinNTDE.TaskManagerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Width="680" Height="540" MinWidth="545" MinHeight="330"
        UseLayoutRounding="True">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,9"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CPU usage" Foreground="{DynamicResource Muted}"/>
                    <TextBlock x:Name="CpuUsage" Text="—" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="CPU usage"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="RAM usage" Foreground="{DynamicResource Muted}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MemoryUsage" Text="—" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="RAM usage"/>
                        <TextBlock x:Name="MemoryTotal" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="C: disk activity" Foreground="{DynamicResource Muted}"/>
                    <TextBlock x:Name="DiskUsage" Text="—" FontSize="23" FontWeight="SemiBold" AutomationProperties.Name="C: disk activity"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search processes" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="6,4"
                     AutomationProperties.Name="Search processes" ToolTip="Search by name or PID"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="EndTaskButton" Content="End Task" IsEnabled="False" Click="EndSelected" Margin="0,0,6,0"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClicked" Margin="0,0,14,0"/>
                <CheckBox x:Name="AutoRefresh" Content="Auto-refresh" Click="AutoRefreshChanged" VerticalAlignment="Center"/>
            </WrapPanel>
            <TextBlock x:Name="Status" Margin="0,8,0,0" MinHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        </StackPanel>

        <ListView x:Name="ProcessList" SelectionMode="Extended" SelectionChanged="SelectionChanged"
                  ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="Processes">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Process" Width="410">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Indent}" LastChildFill="True">
                                    <Button Content="{Binding Expander}" Visibility="{Binding ExpanderVisibility}"
                                            AutomationProperties.Name="{Binding ExpanderName}" Click="ToggleGroup"
                                            Width="23" Height="22" MinHeight="0" Padding="0" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Executable}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContextOnly}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
