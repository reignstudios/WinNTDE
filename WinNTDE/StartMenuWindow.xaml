<Window x:Class="WinNTDE.StartMenuWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start" Style="{DynamicResource ShellWindow}" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="AppButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Raised}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,5,3"/>
        </Style>
        <DataTemplate x:Key="PinnedTile">
            <Button Style="{StaticResource AppButton}" Margin="2" Padding="4" Click="OpenApp" ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu Style="{DynamicResource ShellMenu}" Opened="OpenPinMenu" Closed="ClosePinMenu">
                        <MenuItem Header="Unpin from Start"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Image Width="34" Height="34" Source="{Binding Icon}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Name}" MaxWidth="104" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="AppRow">
            <Button Style="{StaticResource AppButton}" Padding="7,4" HorizontalContentAlignment="Stretch"
                    Click="OpenApp" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu Style="{DynamicResource ShellMenu}" Opened="OpenPinMenu" Closed="ClosePinMenu">
                        <MenuItem Header="Pin to Start"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <DockPanel>
                    <Image DockPanel.Dock="Left" Width="21" Height="21" Source="{Binding Icon}" Margin="0,0,10,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" MaxWidth="150" Margin="8,0,0,0"
                               Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0" Padding="14,9,9,6">
                <WrapPanel>
                    <Button Style="{StaticResource QuickAction}" Content="File Explorer" Click="OpenExplorer"/>
                    <Button Style="{StaticResource QuickAction}" Content="Settings" Click="OpenSettings"/>
                    <Button Style="{StaticResource QuickAction}" Content="Run…" Click="RunCommand"/>
                    <Button Style="{StaticResource QuickAction}" Content="Task Manager" Click="OpenTaskManager"/>
                    <Button Style="{StaticResource QuickAction}" Content="Exit WinNTDE" Click="ExitDesktop"/>
                </WrapPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Margin="15,13,15,6">
                <Grid>
                    <TextBox x:Name="SearchBox" Height="36" Padding="31,5,8,5" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search apps"/>
                    <Path Data="M 10,5 A 5,5 0 1 1 0,5 A 5,5 0 1 1 10,5 M 9,9 L 14,14"
                          Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                          Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeEndLineCap="Round"/>
                    <TextBlock Text="Search apps" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <DockPanel Margin="0,12,0,0">
                    <Button x:Name="ViewButton" DockPanel.Dock="Right" Content="All apps" Click="ToggleApps"/>
                    <TextBlock x:Name="ViewTitle" Text="Pinned apps" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
            <Grid Margin="13,0,13,8">
                <ScrollViewer x:Name="PinnedView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Pins" ItemTemplate="{StaticResource PinnedTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="116" ItemHeight="76"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <ListBox x:Name="AppList" Visibility="Collapsed" ItemTemplate="{StaticResource AppRow}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Apps"/>
                <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"
                           TextWrapping="Wrap" Margin="4,7" VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
